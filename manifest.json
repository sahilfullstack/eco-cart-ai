{
  "manifest_version": 3,
  "name": "EcoCart AI",
  "version": "1.0.0",
  "description": "Make your online shopping more sustainable with AI-powered environmental impact analysis",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.flipkart.com/*",
    "*://*.walmart.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.flipkart.com/*",
        "*://*.walmart.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
